# Copy to ~/.config/search-work-world/secrets.env (or point AUTOPILOT_SECRETS_FILE at any path).
# Never commit the real file. Every key is optional; leave out what you do not use.

# LLM providers (name -> key_env in autopilot/config.json). Enable one with:
#   python tools/autopilot.py llm --enable <name>
LLM7_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOKENHARBOR_API_KEY=
OPENAI_API_KEY=
AUTOPILOT_LLM_BASE_URL=

# Mailbox the bot reads (outcomes + ATS verification codes). Use an app password, never your real one.
AUTOPILOT_EMAIL_ADDRESS=
AUTOPILOT_EMAIL_APP_PASSWORD=

# Extra vacancy sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
TAVILY_API_KEY=
