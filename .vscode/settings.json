{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/autopilot/chrome-profile/**": true,
    "**/autopilot/screenshots/**": true,
    "**/tools/__pycache__/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/package-lock.json": true,
    "**/autopilot/chrome-profile/**": true,
    "**/autopilot/screenshots/**": true,
    "**/tools/__pycache__/**": true
  },
  "files.associations": {
    "*.env": "dotenv"
  }
}
